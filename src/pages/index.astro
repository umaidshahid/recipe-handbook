---
import Layout from '../layouts/Layout.astro';
import RecipeCard from '../components/RecipeCard.astro';
import { getRecipes, colourFor, slugify, tagLabel, tagTint, totalTime, yieldLabel } from '../lib/recipes';
import { SITE } from '../site';

const recipes = await getRecipes();
const featuredIndex = recipes.findIndex((r) => r.data.featured);
const featured = featuredIndex >= 0 ? recipes[featuredIndex] : undefined;
const featuredColour = colourFor(featuredIndex);
const tags = [...new Set(recipes.flatMap((r) => r.data.tags.map(slugify)))].sort();
const count = (n: number) => `${n} recipe${n === 1 ? '' : 's'}`;
---

<Layout>
	<div class="home">
		<section class="intro">
			<h1>Things worth cooking <span class="highlight">again.</span></h1>
			<p>{SITE.description}</p>
		</section>

		{
			featured && (
				<a href={`/recipes/${featured.id}/`} class="featured" style={`--tint: ${featuredColour.tint}`}>
					<div class="featured-text">
						<span class="pill featured-label">This week</span>
						<h2>{featured.data.title}</h2>
						<p>{featured.data.description}</p>
						<div class="featured-meta">
							{totalTime(featured.data) && <span>{totalTime(featured.data)}</span>}
							{yieldLabel(featured.data) && <span>{yieldLabel(featured.data)}</span>}
							<span class="featured-cta">Cook it →</span>
						</div>
					</div>
					<svg class="featured-art" aria-hidden="true" width="260" height="260" viewBox="0 0 260 260">
						<circle cx="130" cy="130" r="120" fill="var(--bg)" />
						<circle cx="130" cy="130" r="92" fill="none" stroke="var(--ink)" stroke-width="2" stroke-dasharray="2 10" stroke-linecap="round" />
						<circle cx="130" cy="130" r="64" fill={featuredColour.dot} />
						<circle cx="108" cy="114" r="10" fill="#F3DE9A" />
						<circle cx="150" cy="140" r="8" fill="#9CC27E" />
						<circle cx="126" cy="156" r="7" fill="#9CC27E" />
						<circle cx="154" cy="108" r="6" fill="#FBF8F2" />
						<path d="M30 230 L80 180" stroke="var(--ink)" stroke-width="6" stroke-linecap="round" />
					</svg>
				</a>
			)
		}

		<section class="filters">
			<label for="search" class="visually-hidden">Search recipes</label>
			<div class="search">
				<svg aria-hidden="true" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="var(--muted)" stroke-width="2" stroke-linecap="round"
					><circle cx="11" cy="11" r="7"></circle><path d="M20 20l-3.5-3.5"></path></svg
				>
				<input id="search" type="search" placeholder="Search by name or tag…" autocomplete="off" />
				<kbd aria-hidden="true">/</kbd>
			</div>
			<div id="tags" class="tags" role="group" aria-label="Filter by tag">
				<button type="button" class="tag" data-tag="" aria-pressed="true">All</button>
				{
					tags.map((tag, i) => (
						<button type="button" class="tag" data-tag={tag} aria-pressed="false" style={`--tint: ${tagTint(tag, i)}`}>
							{tagLabel(tag)}
						</button>
					))
				}
			</div>
		</section>

		<section class="list">
			<div class="list-head">
				<h2 id="list-title">All recipes</h2>
				<span id="list-count" aria-live="polite">{count(recipes.length)}</span>
			</div>
			<div class="grid">
				{recipes.map((recipe, i) => <RecipeCard recipe={recipe} index={i} />)}
			</div>
			<p id="empty" class="empty" hidden>Nothing matches that yet. Try another ingredient or tag.</p>
		</section>
	</div>

	<Fragment slot="footer">
		<span>Every recipe is a Markdown file.</span>
		{SITE.repoUrl && <a href={SITE.repoUrl}>View source</a>}
	</Fragment>
</Layout>

<script>
	const search = document.getElementById('search') as HTMLInputElement;
	const tagButtons = [...document.querySelectorAll<HTMLButtonElement>('.tag')];
	const cards = [...document.querySelectorAll<HTMLElement>('.card')];
	const title = document.getElementById('list-title')!;
	const countEl = document.getElementById('list-count')!;
	const empty = document.getElementById('empty')!;

	let activeTag = new URLSearchParams(location.search).get('tag') ?? '';
	if (!tagButtons.some((b) => b.dataset.tag === activeTag)) activeTag = '';

	function update() {
		const words = search.value.toLowerCase().split(/\s+/).filter(Boolean);
		let shown = 0;
		for (const card of cards) {
			const matchesTag = !activeTag || card.dataset.tags!.split(' ').includes(activeTag);
			const matchesSearch = words.every((w) => card.dataset.search!.includes(w));
			card.hidden = !(matchesTag && matchesSearch);
			if (!card.hidden) shown++;
		}
		for (const button of tagButtons) button.setAttribute('aria-pressed', String(button.dataset.tag === activeTag));
		const activeButton = tagButtons.find((b) => b.dataset.tag === activeTag);
		title.textContent = activeTag ? activeButton!.textContent!.trim() : 'All recipes';
		countEl.textContent = `${shown} recipe${shown === 1 ? '' : 's'}`;
		empty.hidden = shown > 0;

		const url = new URL(location.href);
		if (activeTag) url.searchParams.set('tag', activeTag);
		else url.searchParams.delete('tag');
		history.replaceState(null, '', url);
	}

	search.addEventListener('input', update);
	for (const button of tagButtons) {
		button.addEventListener('click', () => {
			activeTag = button.dataset.tag!;
			update();
		});
	}

	document.addEventListener('keydown', (e) => {
		const target = e.target as HTMLElement;
		if (e.key !== '/' || e.metaKey || e.ctrlKey || e.altKey) return;
		if (target.closest('input, textarea, select, [contenteditable]')) return;
		e.preventDefault();
		search.focus();
	});

	update();
</script>

<style>
	.home {
		display: flex;
		flex-direction: column;
		gap: 56px;
		padding-top: 24px;
	}

	.intro {
		display: flex;
		flex-direction: column;
		gap: 20px;
	}

	.intro h1 {
		font-weight: 800;
		font-size: clamp(48px, 9vw, 112px);
		line-height: 0.95;
		letter-spacing: -0.045em;
		max-width: 980px;
	}

	.highlight {
		display: inline-block;
		background: var(--accent);
		color: var(--on-accent);
		padding: 0.02em 0.16em 0.08em;
		border-radius: 0.2em;
		transform: rotate(-2deg);
	}

	.intro p {
		font-size: 19px;
		color: var(--muted);
		max-width: 560px;
	}

	.featured {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 32px;
		padding: 40px;
		border-radius: 28px;
		background: var(--tint);
		overflow: hidden;
	}

	.featured:hover {
		opacity: 1;
	}

	.featured-text {
		flex: 999 1 360px;
		display: flex;
		flex-direction: column;
		gap: 16px;
	}

	.featured-label {
		align-self: flex-start;
		letter-spacing: 0.04em;
		text-transform: uppercase;
	}

	.featured h2 {
		font-weight: 800;
		font-size: clamp(36px, 5vw, 56px);
		line-height: 1;
		letter-spacing: -0.035em;
	}

	.featured p {
		font-size: 18px;
		max-width: 460px;
	}

	.featured-meta {
		display: flex;
		flex-wrap: wrap;
		gap: 8px;
		font-size: 15px;
		font-weight: 500;
	}

	.featured-meta span {
		padding: 8px 14px;
		border-radius: 999px;
		border: 1.5px solid var(--ink);
	}

	.featured-meta .featured-cta {
		padding: 8px 16px;
		background: var(--ink);
		color: var(--bg);
	}

	.featured:hover .featured-cta {
		background: var(--accent);
		border-color: var(--accent);
		color: var(--on-accent);
	}

	.featured-art {
		flex: 1 1 200px;
		max-width: 260px;
		height: auto;
	}

	.filters {
		display: flex;
		flex-direction: column;
		gap: 16px;
		scroll-margin-top: 24px;
	}

	.search {
		display: flex;
		align-items: center;
		gap: 12px;
		height: 60px;
		padding: 0 20px;
		border: 1.5px solid var(--line);
		border-radius: 999px;
		background: var(--surface);
	}

	.search:focus-within {
		border-color: var(--accent);
	}

	.search input {
		flex: 1;
		min-width: 0;
		height: 100%;
		border: 0;
		outline: none;
		font: inherit;
		font-size: 17px;
		background: transparent;
		color: var(--ink);
	}

	.search input::placeholder {
		color: var(--muted);
	}

	kbd {
		font-family: inherit;
		font-size: 13px;
		color: var(--muted);
		border: 1px solid var(--line);
		border-radius: 6px;
		padding: 2px 8px;
	}

	.tags {
		display: flex;
		flex-wrap: wrap;
		gap: 8px;
	}

	.tag {
		height: 44px;
		padding: 0 20px;
		border-radius: 999px;
		border: 0;
		background: var(--tint, var(--surface));
		color: var(--ink);
		font: inherit;
		font-size: 15px;
		font-weight: 500;
		cursor: pointer;
	}

	.tag[aria-pressed='true'] {
		background: var(--ink);
		color: var(--bg);
		font-weight: 600;
	}

	.list {
		display: flex;
		flex-direction: column;
		gap: 20px;
	}

	.list-head {
		display: flex;
		justify-content: space-between;
		align-items: baseline;
		gap: 12px;
	}

	.list-head h2 {
		font-weight: 700;
		font-size: 32px;
		letter-spacing: -0.03em;
	}

	.list-head span {
		font-size: 15px;
		color: var(--muted);
	}

	.grid {
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(min(300px, 100%), 1fr));
		gap: 20px;
	}

	.empty {
		color: var(--muted);
		padding: 32px 0;
	}

	@media (max-width: 640px) {
		.home {
			gap: 40px;
			padding-top: 12px;
		}

		.featured {
			padding: 24px 20px;
			border-radius: 24px;
		}

		.featured-art {
			display: none;
		}

		.search {
			height: 52px;
		}

		kbd {
			display: none;
		}
	}
</style>
