---
import type { GetStaticPaths } from 'astro';
import Layout from '../../layouts/Layout.astro';
import { getRecipes, colourFor, inline, parseBody, slugify, tagLabel, type Recipe } from '../../lib/recipes';
import { SITE } from '../../site';

export const getStaticPaths = (async () => {
	const recipes = await getRecipes();
	return recipes.map((recipe, index) => ({ params: { id: recipe.id }, props: { recipe, index } }));
}) satisfies GetStaticPaths;

interface Props {
	recipe: Recipe;
	index: number;
}

const { recipe, index } = Astro.props;
const { data } = recipe;
const { tint, dot } = colourFor(index);
const { ingredients, steps, notes } = parseBody(recipe.body);
const file = `recipes/${recipe.id}.md`;

const meta = [
	data.prep && { label: 'Prep', value: data.prep },
	data.cook && { label: 'Cook', value: data.cook },
	!data.cook && data.time && { label: 'Total', value: data.time },
	data.makes ? { label: 'Makes', value: data.makes } : data.serves !== undefined && { label: 'Serves', value: data.serves },
].filter((item): item is { label: string; value: string | number } => !!item);
---

<Layout title={data.title} description={data.description}>
	<div class="recipe" style={`--tint: ${tint}`}>
		<section class="hero">
			<svg class="hero-art" aria-hidden="true" width="340" height="340" viewBox="0 0 340 340">
				<circle cx="170" cy="170" r="160" fill="none" stroke="var(--ink)" stroke-width="2" stroke-dasharray="2 12" stroke-linecap="round" />
				<circle cx="170" cy="170" r="96" fill={dot} />
				<circle cx="140" cy="146" r="14" fill="#F3DE9A" />
				<circle cx="200" cy="186" r="11" fill="#9CC27E" />
				<circle cx="160" cy="214" r="9" fill="#9CC27E" />
			</svg>
			<a href="/" class="back">
				<svg aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"
					><path d="M15 18l-6-6 6-6"></path></svg
				>All recipes
			</a>
			{
				data.tags.length > 0 && (
					<div class="hero-tags">
						{data.tags.map((tag) => (
							<a href={`/?tag=${slugify(tag)}#tags`} class="pill">
								{tagLabel(tag)}
							</a>
						))}
					</div>
				)
			}
			<h1>{data.title}</h1>
			<p class="lede">{data.description}</p>
			{
				meta.length > 0 && (
					<dl class="meta">
						{meta.map(({ label, value }) => (
							<div>
								<dt>{label}</dt>
								<dd>{value}</dd>
							</div>
						))}
					</dl>
				)
			}
		</section>

		<div class="tabs" role="tablist" aria-label="Recipe sections" hidden>
			<button type="button" role="tab" id="tab-ingredients" aria-controls="ingredients" aria-selected="true">Ingredients</button>
			<button type="button" role="tab" id="tab-method" aria-controls="method" aria-selected="false" tabindex="-1">Method</button>
		</div>

		<div class="columns">
			<section id="ingredients" class="ingredients" role="tabpanel" aria-labelledby="tab-ingredients" data-recipe={recipe.id}>
				<div class="ingredients-head">
					<h2>Ingredients</h2>
					<span id="progress-label">0 of {ingredients.length}</span>
				</div>
				<div class="progress" aria-hidden="true"><div id="progress-bar"></div></div>
				<ul>
					{
						ingredients.map((item) => (
							<li>
								<label>
									<input type="checkbox" />
									<span>
										{item.quantity && <strong set:html={inline(item.quantity)} />} <Fragment set:html={inline(item.name)} />
									</span>
								</label>
							</li>
						))
					}
				</ul>
			</section>

			<section id="method" class="method" role="tabpanel" aria-labelledby="tab-method">
				<h2>Method</h2>
				<ol>
					{
						steps.map((step, i) => (
							<li>
								<span class="step-number" aria-hidden="true">
									{i + 1}
								</span>
								<p set:html={inline(step)} />
							</li>
						))
					}
				</ol>
				{
					notes.length > 0 && (
						<aside class="notes">
							<h3>Notes</h3>
							{notes.map((note) => (
								<p set:html={inline(note)} />
							))}
						</aside>
					)
				}
			</section>
		</div>
	</div>

	<Fragment slot="footer">
		<span class="file">{file}</span>
		{SITE.repoUrl && <a href={`${SITE.repoUrl}/edit/${SITE.branch}/${file}`}>Edit this recipe</a>}
	</Fragment>
</Layout>

<script>
	// Ingredient checklist, remembered per recipe so you can leave the page mid-cook.
	const section = document.getElementById('ingredients')!;
	const boxes = [...section.querySelectorAll<HTMLInputElement>('input[type="checkbox"]')];
	const label = document.getElementById('progress-label')!;
	const bar = document.getElementById('progress-bar')!;
	const key = `checked:${section.dataset.recipe}`;

	let saved: number[] = [];
	try {
		saved = JSON.parse(localStorage.getItem(key) ?? '[]');
	} catch {}
	boxes.forEach((box, i) => (box.checked = saved.includes(i)));

	function sync() {
		const done = boxes.filter((b) => b.checked).length;
		label.textContent = `${done} of ${boxes.length}`;
		bar.style.width = boxes.length ? `${(done / boxes.length) * 100}%` : '0';
		try {
			localStorage.setItem(key, JSON.stringify(boxes.flatMap((b, i) => (b.checked ? [i] : []))));
		} catch {}
	}
	boxes.forEach((box) => box.addEventListener('change', sync));
	sync();

	// Ingredients / Method tabs (only visible on narrow screens).
	const columns = document.querySelector<HTMLElement>('.columns')!;
	const tabs = [...document.querySelectorAll<HTMLButtonElement>('[role="tab"]')];
	document.querySelector<HTMLElement>('.tabs')!.hidden = false;
	columns.dataset.tab = 'ingredients';
	function select(tab: HTMLButtonElement) {
		for (const t of tabs) {
			const active = t === tab;
			t.setAttribute('aria-selected', String(active));
			t.tabIndex = active ? 0 : -1;
		}
		columns.dataset.tab = tab.getAttribute('aria-controls')!;
	}
	tabs.forEach((tab, i) => {
		tab.addEventListener('click', () => select(tab));
		tab.addEventListener('keydown', (e) => {
			if (e.key !== 'ArrowLeft' && e.key !== 'ArrowRight') return;
			const next = tabs[(i + (e.key === 'ArrowRight' ? 1 : tabs.length - 1)) % tabs.length];
			select(next);
			next.focus();
		});
	});
</script>

<style>
	.recipe {
		display: flex;
		flex-direction: column;
		gap: 48px;
		font-size: 17px;
		line-height: 1.6;
	}

	.hero {
		position: relative;
		overflow: hidden;
		display: flex;
		flex-direction: column;
		gap: 20px;
		padding: 48px 40px;
		border-radius: 32px;
		background: var(--tint);
	}

	.hero > :not(.hero-art) {
		position: relative;
	}

	.hero-art {
		position: absolute;
		right: -80px;
		top: -70px;
	}

	.back {
		display: inline-flex;
		align-items: center;
		gap: 6px;
		min-height: 44px;
		font-size: 15px;
		font-weight: 500;
		align-self: flex-start;
		margin-top: -12px;
	}

	.hero-tags {
		display: flex;
		flex-wrap: wrap;
		gap: 8px;
	}

	.hero h1 {
		font-weight: 800;
		font-size: clamp(44px, 8vw, 96px);
		line-height: 0.95;
		letter-spacing: -0.045em;
		max-width: 760px;
	}

	.lede {
		font-size: 20px;
		max-width: 560px;
	}

	.meta {
		margin: 8px 0 0;
		display: flex;
		flex-wrap: wrap;
		gap: 10px;
	}

	.meta div {
		display: flex;
		gap: 8px;
		align-items: baseline;
		padding: 10px 18px;
		border-radius: 999px;
		background: var(--bg);
	}

	.meta dt {
		font-size: 13px;
		color: var(--muted);
		font-weight: 600;
		text-transform: uppercase;
		letter-spacing: 0.06em;
	}

	.meta dd {
		margin: 0;
		font-weight: 600;
	}

	.tabs {
		display: none;
	}

	.columns {
		display: flex;
		flex-wrap: wrap;
		gap: 40px;
		align-items: flex-start;
	}

	.ingredients {
		flex: 1 1 320px;
		max-width: 380px;
		position: sticky;
		top: 24px;
		display: flex;
		flex-direction: column;
		gap: 12px;
		padding: 28px;
		background: var(--surface);
		border: 1px solid var(--line);
		border-radius: 24px;
	}

	.ingredients-head {
		display: flex;
		justify-content: space-between;
		align-items: baseline;
	}

	h2 {
		font-weight: 700;
		font-size: 28px;
		letter-spacing: -0.03em;
	}

	.ingredients-head span {
		font-size: 14px;
		color: var(--muted);
	}

	.progress {
		height: 6px;
		border-radius: 999px;
		background: var(--line);
		overflow: hidden;
	}

	#progress-bar {
		width: 0;
		height: 100%;
		background: var(--accent);
		transition: width 0.2s ease;
	}

	.ingredients ul {
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.ingredients li {
		border-bottom: 1px dashed var(--line);
	}

	.ingredients li:last-child {
		border-bottom: 0;
	}

	.ingredients label {
		display: flex;
		gap: 12px;
		align-items: center;
		min-height: 48px;
		padding: 6px 0;
		cursor: pointer;
	}

	.ingredients input {
		flex: none;
		width: 20px;
		height: 20px;
		margin: 0;
		accent-color: var(--accent);
		cursor: pointer;
	}

	.ingredients input:checked + span {
		opacity: 0.55;
		text-decoration: line-through;
	}

	.ingredients strong {
		font-weight: 600;
	}

	.method {
		flex: 999 1 420px;
		min-width: 0;
		max-width: 680px;
		display: flex;
		flex-direction: column;
		gap: 24px;
	}

	.method ol {
		margin: 0;
		padding: 0;
		list-style: none;
		display: flex;
		flex-direction: column;
		gap: 16px;
	}

	.method li {
		display: flex;
		gap: 20px;
		padding: 20px 24px;
		border-radius: 20px;
		background: var(--surface);
		border: 1px solid var(--line);
	}

	.step-number {
		flex: none;
		width: 44px;
		height: 44px;
		border-radius: 14px;
		background: var(--accent);
		color: var(--on-accent);
		display: flex;
		align-items: center;
		justify-content: center;
		font-family: var(--font-display);
		font-weight: 800;
		font-size: 20px;
	}

	.method li p {
		padding-top: 8px;
	}

	.notes {
		display: flex;
		flex-direction: column;
		gap: 6px;
		padding: 20px 24px;
		border-radius: 20px;
		background: var(--tint-mustard);
	}

	.notes h3 {
		font-weight: 700;
		font-size: 20px;
		letter-spacing: -0.02em;
	}

	.file {
		font-family: ui-monospace, monospace;
	}

	@media (max-width: 720px) {
		.recipe {
			gap: 20px;
			font-size: 16px;
		}

		.hero {
			gap: 12px;
			padding: 24px 20px;
			border-radius: 24px;
		}

		.hero-art {
			width: 180px;
			height: 180px;
			right: -60px;
			top: -50px;
		}

		.back {
			font-size: 14px;
			margin-top: -10px;
		}

		.hero-tags {
			gap: 6px;
		}

		.hero-tags .pill {
			padding: 3px 10px;
			font-size: 12px;
		}

		.lede {
			font-size: 16px;
		}

		.meta {
			margin-top: 4px;
			display: grid;
			grid-auto-flow: column;
			grid-auto-columns: minmax(0, 1fr);
			gap: 6px;
		}

		.meta div {
			flex-direction: column;
			gap: 0;
			padding: 8px 10px;
			border-radius: 14px;
		}

		.meta dt {
			font-size: 11px;
		}

		.tabs {
			display: grid;
			grid-template-columns: repeat(2, minmax(0, 1fr));
			padding: 4px;
			background: var(--surface);
			border: 1px solid var(--line);
			border-radius: 999px;
			position: sticky;
			top: 8px;
			z-index: 5;
		}

		.tabs[hidden] {
			display: none;
		}

		.tabs button {
			height: 44px;
			border: 0;
			border-radius: 999px;
			background: transparent;
			font: inherit;
			font-size: 15px;
			font-weight: 500;
			color: var(--muted);
			cursor: pointer;
		}

		.tabs button[aria-selected='true'] {
			background: var(--accent);
			color: var(--on-accent);
			font-weight: 600;
		}

		.columns {
			gap: 20px;
		}

		.columns[data-tab='ingredients'] .method,
		.columns[data-tab='method'] .ingredients {
			display: none;
		}

		.ingredients {
			position: static;
			max-width: none;
			padding: 20px;
			gap: 8px;
			border-radius: 22px;
		}

		h2 {
			font-size: 24px;
		}

		.method {
			gap: 10px;
		}

		.method ol {
			gap: 10px;
		}

		.method li {
			gap: 14px;
			padding: 16px;
			border-radius: 18px;
		}

		.step-number {
			width: 36px;
			height: 36px;
			border-radius: 12px;
			font-size: 17px;
		}

		.method li p {
			padding-top: 4px;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		#progress-bar {
			transition: none;
		}
	}
</style>
